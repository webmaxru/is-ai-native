{
  "routes": [
    {
      "route": "/_webmcp_",
      "rewrite": "/webmcp.html"
    },
    {
      "route": "/_/report/*",
      "rewrite": "/index.html",
      "headers": {
        "Cache-Control": "no-cache",
        "X-Robots-Tag": "noindex, nofollow, noarchive"
      }
    },
    {
      "route": "/manifest.webmanifest",
      "redirect": "/site.webmanifest",
      "statusCode": 301
    },
    {
      "route": "/runtime-config.js",
      "headers": {
        "Cache-Control": "no-store"
      }
    },
    {
      "route": "/index.html",
      "headers": {
        "Cache-Control": "no-cache"
      }
    },
    {
      "route": "/src/*",
      "headers": {
        "Cache-Control": "no-cache"
      }
    },
    {
      "route": "/assets/*",
      "headers": {
        "Cache-Control": "public, max-age=86400",
        "Cross-Origin-Resource-Policy": "cross-origin"
      }
    },
    {
      "route": "/favicon*",
      "headers": {
        "Cache-Control": "public, max-age=86400",
        "Cross-Origin-Resource-Policy": "cross-origin"
      }
    },
    {
      "route": "/social-card*",
      "headers": {
        "Cache-Control": "public, max-age=86400",
        "Cross-Origin-Resource-Policy": "cross-origin"
      }
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/api/*",
      "/assets/*",
      "/src/*",
      "/runtime-config.js",
      "/webmcp.html",
      "/robots.txt",
      "/sitemap.xml",
      "/site.webmanifest",
      "/manifest.webmanifest",
      "/favicon*",
      "/apple-touch-icon.png",
      "/android-chrome-*.png",
      "/mask*",
      "/mstile-*.png",
      "/social-card*"
    ]
  },
  "globalHeaders": {
    "Content-Security-Policy": "default-src 'self'; script-src 'self' https://*.posthog.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://*.azurecontainerapps.io https://*.applicationinsights.azure.com https://*.in.applicationinsights.azure.com https://*.visualstudio.com https://*.posthog.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'",
    "Permissions-Policy": "camera=(), geolocation=(), microphone=()",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY"
  },
  "mimeTypes": {
    ".webmanifest": "application/manifest+json"
  }
}
